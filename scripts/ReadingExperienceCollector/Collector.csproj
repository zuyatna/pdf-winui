<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DiagnosticsClientPath Condition="'$(DiagnosticsClientPath)' == ''">$(MSBuildSDKsPath)/../Extensions/Microsoft.Diagnostics.NETCore.Client.dll</DiagnosticsClientPath>
    <TraceEventPath Condition="'$(TraceEventPath)' == ''">$(ProgramFiles)/Microsoft Visual Studio/18/Community/Common7/IDE/PrivateAssemblies/Microsoft.Diagnostics.Tracing.TraceEvent.dll</TraceEventPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Diagnostics.NETCore.Client" HintPath="$(DiagnosticsClientPath)" />
    <Reference Include="Microsoft.Diagnostics.Tracing.TraceEvent" HintPath="$(TraceEventPath)" />
  </ItemGroup>
</Project>
