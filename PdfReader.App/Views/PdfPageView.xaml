<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PdfReader.App.Views.PdfPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Width="{x:Bind PageItem.DisplayWidth, Mode=OneWay, FallbackValue=612}"
        Height="{x:Bind PageItem.DisplayHeight, Mode=OneWay, FallbackValue=792}"
        HorizontalAlignment="Center"
        Background="{x:Bind PageItem.PageBackgroundBrush, Mode=OneWay}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind PageItem.PageNumber, Mode=OneWay}" />

            <Image
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Source="{x:Bind PageItem.RenderedImage, Mode=OneWay}"
                Stretch="Fill" />
        </Grid>
    </Border>
</UserControl>
