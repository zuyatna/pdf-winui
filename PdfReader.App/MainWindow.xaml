<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdfReader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdfReader.App"
    xmlns:vm="using:PdfReader.App.ViewModels"
    xmlns:views="using:PdfReader.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Page
        x:Name="RootPage"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RequestedTheme="{x:Bind ViewModel.RootRequestedTheme, Mode=OneWay}">
        <Page.KeyboardAccelerators>
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnReaderAcceleratorInvoked" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnReaderAcceleratorInvoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnReaderAcceleratorInvoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnReaderAcceleratorInvoked" />
        </Page.KeyboardAccelerators>
        <Grid
            x:Name="RootGrid"
            AllowDrop="True"
            DragOver="OnRootGridDragOver"
            Drop="OnRootGridDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="NavigationButton" x:Uid="NavigationToggleButton"
                            Padding="10" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleNavigationPaneCommand}"
                            IsChecked="{x:Bind ViewModel.IsNavigationPaneOpen, Mode=OneWay}">
                            <FontIcon Glyph="&#xE700;" FontSize="16" />
                        </ToggleButton>
                        <Button x:Name="OpenButton" x:Uid="OpenPdfButton"
                            Command="{x:Bind ViewModel.OpenDocumentCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock x:Uid="OpenPdfButtonText" Text="Open PDF" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="InteractionModeButton" x:Uid="InteractionModeButton"
                            MinWidth="100" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                            Content="{x:Bind ViewModel.InteractionModeText, Mode=OneWay}"
                            IsChecked="{x:Bind ViewModel.IsTextSelectionMode, Mode=TwoWay}" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}">
                        <Button x:Uid="PrevPageButton" Command="{x:Bind ViewModel.PreviousPageCommand}" Padding="8">
                            <FontIcon FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                        <TextBox x:Uid="GoToPageBox" x:Name="GoToPageTextBox" Width="52" TextAlignment="Center"
                            KeyDown="OnGoToPageTextBoxKeyDown"
                            Text="{x:Bind ViewModel.GoToPageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0"
                            Text="{x:Bind ViewModel.TotalPagesSuffixText, Mode=OneWay}" />
                        <Button x:Uid="NextPageButton" Command="{x:Bind ViewModel.NextPageCommand}" Padding="8">
                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                        Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}">
                        <Button x:Uid="ZoomOutButton" Command="{x:Bind ViewModel.ZoomOutCommand}" Padding="8">
                            <FontIcon FontSize="12" Glyph="&#xE71F;" />
                        </Button>
                        <Button x:Name="ZoomOptionsButton" x:Uid="ZoomOptionsButton" MinWidth="64"
                            Content="{x:Bind ViewModel.ZoomPercentageText, Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="ZoomFitWidthMenuItem" Command="{x:Bind ViewModel.SetFitWidthCommand}" />
                                    <MenuFlyoutItem x:Uid="ZoomFitPageMenuItem" Command="{x:Bind ViewModel.SetFitPageCommand}" />
                                    <MenuFlyoutItem x:Uid="ZoomActualSizeMenuItem" Command="{x:Bind ViewModel.ResetZoomCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Uid="ZoomInButton" Command="{x:Bind ViewModel.ZoomInCommand}" Padding="8">
                            <FontIcon FontSize="12" Glyph="&#xE8A3;" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="AdvancedMenuButton" x:Uid="AdvancedMenuButton" Grid.Column="4" Padding="10">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="CopyMenuItem" Command="{x:Bind ViewModel.CopySelectedTextCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasTextSelection, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="FindMenuItem" Command="{x:Bind ViewModel.OpenSearchBarCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Uid="DarkReadingMenuItem"
                                    IsChecked="{x:Bind ViewModel.IsDarkReadingMode, Mode=TwoWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE708;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="AppearanceMenuItem" Command="{x:Bind ViewModel.ToggleSettingsPaneCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="16,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.SearchBarVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBox
                        x:Uid="SearchQueryTextBox"
                        x:Name="SearchQueryTextBox"
                        Width="240"
                        VerticalAlignment="Center"
                        KeyDown="OnSearchQueryTextBoxKeyDown"
                        PlaceholderText="Find in document..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Uid="SearchButton"
                        Command="{x:Bind ViewModel.ExecuteSearchCommand}"
                        Content="Search" />
                    <CheckBox
                        x:Uid="SearchMatchCaseCheckBox"
                        MinWidth="0"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Content="Match case"
                        IsChecked="{x:Bind ViewModel.SearchMatchCase, Mode=TwoWay}" />
                    <TextBlock
                        MinWidth="56"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                        TextAlignment="Center" />
                    <Button
                        x:Uid="SearchPrevButton"
                        Command="{x:Bind ViewModel.PreviousSearchMatchCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        Padding="8,6">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F3" Modifiers="Shift" />
                        </Button.KeyboardAccelerators>
                        <FontIcon FontSize="12" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        x:Uid="SearchNextButton"
                        Command="{x:Bind ViewModel.NextSearchMatchCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        Padding="8,6">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F3" />
                        </Button.KeyboardAccelerators>
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        x:Uid="SearchCloseButton"
                        Command="{x:Bind ViewModel.CloseSearchBarCommand}"
                        Padding="8,6">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

            <InfoBar
                x:Uid="ErrorInfoBar"
                Grid.Row="2"
                Title="Error"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <SplitView
                Grid.Row="3"
                DisplayMode="Inline"
                IsPaneOpen="{x:Bind ViewModel.IsSettingsPaneOpen, Mode=TwoWay}"
                OpenPaneLength="340"
                PaneBackground="{ThemeResource LayerFillColorDefaultBrush}"
                PanePlacement="Right">
                <SplitView.Pane>
                    <ScrollViewer Padding="20,16">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SettingsPaneHeader" TextWrapping="Wrap"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="Appearance &amp; Reading Theme" />
                                <Button x:Uid="CloseAppearanceButton" Grid.Column="1" Padding="8"
                                    VerticalAlignment="Top" Command="{x:Bind ViewModel.ToggleSettingsPaneCommand}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>

                            <ComboBox
                                x:Uid="UiThemeComboBox"
                                HorizontalAlignment="Stretch"
                                Header="App UI theme (Layer 1)"
                                SelectedIndex="{x:Bind ViewModel.SelectedUiThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="UiThemeSystemItem" Content="System" />
                                <ComboBoxItem x:Uid="UiThemeLightItem" Content="Light" />
                                <ComboBoxItem x:Uid="UiThemeDarkItem" Content="Dark" />
                            </ComboBox>

                            <ComboBox
                                x:Uid="ReadingThemeComboBox"
                                HorizontalAlignment="Stretch"
                                Header="Page reading theme (Layer 2)"
                                SelectedIndex="{x:Bind ViewModel.SelectedReadingThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="ReadingThemeOriginalItem" Content="Original (Unchanged)" />
                                <ComboBoxItem x:Uid="ReadingThemeDarkItem" Content="Dark (Warm Palette)" />
                                <ComboBoxItem x:Uid="ReadingThemeOledItem" Content="OLED (Pure Black)" />
                            </ComboBox>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <TextBlock
                                x:Uid="PaletteSectionHeader"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Dark Reading Palette (#RRGGBB)" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Uid="PageBackgroundHexBox"
                                    Grid.Column="0"
                                    Header="Page background (paper)"
                                    Text="{x:Bind ViewModel.PageBackgroundHex, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Background="{x:Bind ViewModel.SwatchPageBackgroundBrush, Mode=OneWay}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Uid="TextColorHexBox"
                                    Grid.Column="0"
                                    Header="Text color (ink)"
                                    Text="{x:Bind ViewModel.TextHex, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Background="{x:Bind ViewModel.SwatchTextBrush, Mode=OneWay}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Uid="CanvasColorHexBox"
                                    Grid.Column="0"
                                    Header="Canvas background (around pages)"
                                    Text="{x:Bind ViewModel.CanvasHex, Mode=TwoWay}" />
                                <Border
                                    Grid.Column="1"
                                    Height="32"
                                    VerticalAlignment="Bottom"
                                    Background="{x:Bind ViewModel.SwatchCanvasBrush, Mode=OneWay}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="ApplyPaletteButton"
                                    Command="{x:Bind ViewModel.ApplyPaletteCommand}"
                                    Content="Apply Colors"
                                    Style="{ThemeResource AccentButtonStyle}" />
                                <Button
                                    x:Uid="ResetPaletteButton"
                                    Command="{x:Bind ViewModel.ResetPaletteDefaultsCommand}"
                                    Content="Reset Defaults" />
                            </StackPanel>

                            <Slider
                                x:Uid="ImageDimSlider"
                                Header="Image dimming in dark mode (%)"
                                Maximum="50"
                                Minimum="0"
                                StepFrequency="5"
                                TickFrequency="10"
                                Value="{x:Bind ViewModel.ImageDimPercentage, Mode=TwoWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </SplitView.Pane>

                <SplitView.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="288" Padding="12" BorderThickness="0,0,1,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Visibility="{x:Bind ViewModel.NavigationPaneVisibility, Mode=OneWay}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Uid="ContentsTab" GroupName="DocumentNavigation" HorizontalAlignment="Stretch"
                                        Checked="OnContentsTabChecked"
                                        IsChecked="{x:Bind ViewModel.IsContentsTabSelected, Mode=OneWay}" />
                                    <RadioButton x:Uid="BookmarksTab" GroupName="DocumentNavigation" Grid.Column="1" HorizontalAlignment="Stretch"
                                        Checked="OnBookmarksTabChecked"
                                        IsChecked="{x:Bind ViewModel.IsBookmarksTabSelected, Mode=OneWay}" />
                                </Grid>
                                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ContentsTabVisibility, Mode=OneWay}">
                                    <TextBlock x:Uid="EmptyContentsText" Margin="12" TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind ViewModel.EmptyOutlineVisibility, Mode=OneWay}" />
                                    <ListView x:Uid="ContentsList" ItemsSource="{x:Bind ViewModel.OutlineItems}"
                                        SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOutlineItemClick"
                                        ScrollViewer.HorizontalScrollMode="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OutlineNodeViewModel">
                                                <Grid Padding="{x:Bind ItemPadding}" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap"
                                                        Opacity="{x:Bind TitleOpacity}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind PageBadgeText}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                                <Grid Grid.Row="1" RowSpacing="10" Visibility="{x:Bind ViewModel.BookmarksTabVisibility, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Uid="BookmarkTitleBox" MaxLength="200"
                                        Text="{x:Bind ViewModel.BookmarkTitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Row="1" Spacing="6">
                                        <Button x:Uid="SaveBookmarkButton" HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.SaveBookmarkCommand}" />
                                        <ToggleButton x:Uid="SidebarBookmarkToggle" HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.ToggleCurrentPageBookmarkCommand}"
                                            IsChecked="{x:Bind ViewModel.IsCurrentPageBookmarked, Mode=OneWay}" />
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <TextBlock x:Uid="EmptyBookmarksText" Margin="12" TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.EmptyBookmarksVisibility, Mode=OneWay}" />
                                        <ListView x:Uid="BookmarksList" ItemsSource="{x:Bind ViewModel.Bookmarks}"
                                            SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnBookmarkItemClick">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="4,8" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BookmarkItemViewModel">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay}" />
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind PageBadgeText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Uid="RemoveBookmarkButton" Grid.Column="2" Click="OnRemoveBookmarkClick"
                                                            Padding="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <ScrollViewer
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                            <StackPanel
                                MaxWidth="520"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                                <TextBlock
                                    x:Uid="EmptyStateTitle"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Open a PDF to start reading"
                                    TextAlignment="Center" />
                                <TextBlock
                                    x:Uid="EmptyStateSubtitle"
                                    HorizontalAlignment="Center"
                                    Opacity="0.75"
                                    Text="Select a PDF file from your device for fast, virtualized reading."
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                                <Button
                                    x:Uid="EmptyStateOpenButton"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.OpenDocumentCommand}"
                                    Content="Open PDF..."
                                    Style="{ThemeResource AccentButtonStyle}" />

                                <StackPanel
                                    Margin="0,12,0,0"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.RecentFilesVisibility, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Uid="RecentFilesHeader"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Recent Files" />
                                        <Button
                                            x:Uid="ClearRecentButton"
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.ClearRecentFilesCommand}"
                                            Content="Clear" />
                                    </Grid>

                                    <ListView
                                        IsItemClickEnabled="True"
                                        ItemClick="OnRecentFileItemClick"
                                        ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentFileItem">
                                                <Grid Padding="8,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind FileName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Opacity="0.65"
                                                            Text="{x:Bind DirectoryPath}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Opacity="0.75"
                                                        Text="{x:Bind SummaryText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ListView
                            x:Name="PagesListView"
                            Padding="0,16"
                            HorizontalContentAlignment="Center"
                            Background="{x:Bind ViewModel.CanvasBackgroundBrush, Mode=OneWay}"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                            PointerWheelChanged="OnPagesListViewPointerWheelChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel CacheLength="2.0" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,16" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PdfPageItem">
                                    <views:PdfPageView PageItem="{x:Bind}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>
                    </Grid>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </Page>
</Window>
