<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdfReader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdfReader.App"
    xmlns:vm="using:PdfReader.App.ViewModels"
    xmlns:views="using:PdfReader.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Uid="OpenPdfButton"
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.OpenDocumentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock x:Uid="OpenPdfButtonText" Text="Open PDF" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <ProgressRing
                    Grid.Column="2"
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
        </Border>

        <InfoBar
            x:Uid="ErrorInfoBar"
            Grid.Row="1"
            Title="Error"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <TextBlock
                x:Uid="EmptyStateTitle"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Open a PDF to start reading"
                TextAlignment="Center" />
            <TextBlock
                x:Uid="EmptyStateSubtitle"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="Select a PDF file from your device for fast, virtualized reading."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <Button
                x:Uid="EmptyStateOpenButton"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenDocumentCommand}"
                Content="Open PDF..."
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>

        <ListView
            x:Name="PagesListView"
            Grid.Row="2"
            Padding="0,16"
            HorizontalContentAlignment="Center"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.DocumentVisibility, Mode=OneWay}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel CacheLength="2.0" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,16" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PdfPageItem">
                    <views:PdfPageView PageItem="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
